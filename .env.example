# Copy to .env for reference, then export these variables in your shell.
# ASP.NET Core maps double underscores to configuration section separators.
# Never commit .env or a real JWT key.
ConnectionStrings__DevTrack=Host=localhost;Port=5432;Database=devtrack;Username=YOUR_LOCAL_POSTGRES_ROLE
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
Jwt__Issuer=DevTrack.Api
Jwt__Audience=DevTrack.Web
FrontendUrl=http://localhost:5173
